{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "easygit",
  "version": "0.1.5",
  "identifier": "dev.esaygit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1437",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "easygit",
        "width": 1200,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "skipTaskbar": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "shadow": true,
        "dragDropEnabled": false,
        "devtools": false,
        "backgroundColor": "#e7e8ed"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": "default-src 'self' http://localhost:1437; connect-src ipc: http://ipc.localhost http://localhost:1437 ws://localhost:1437; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "996wuxian",
    "homepage": "https://github.com/996wuxian/easygit",
    "shortDescription": "A desktop Git workspace",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "startMenuFolder": "easygit"
      }
    }
  }
}
